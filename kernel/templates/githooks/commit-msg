#!/bin/sh
# commit-msg hook: reject AI attribution in commit messages.
# Enable with: git config core.hooksPath .githooks
# Rule: agents/execution/WORKFLOW.md, "No AI attribution".

msg_file="$1"

if [ -z "$msg_file" ] || [ ! -r "$msg_file" ]; then
  echo "commit-msg: cannot read commit message file '$msg_file'" >&2
  exit 1
fi

# Ignore git comment lines (starting with '#') before matching.
body=$(grep -v '^#' "$msg_file")

reject() {
  echo "commit-msg: rejected - $1" >&2
  echo "Commits carry no AI attribution. Remove the line and commit again." >&2
  echo "Rule: agents/execution/WORKFLOW.md, \"No AI attribution\"." >&2
  exit 1
}

if printf '%s\n' "$body" | grep -Eiq '^co-authored-by:.*(claude|anthropic|openai|chatgpt|gpt-|copilot|gemini|codex|\bai\b|noreply@anthropic)'; then
  reject "Co-Authored-By line naming an AI model or vendor"
fi

if printf '%s\n' "$body" | grep -Eiq 'generated (with|by) .*(claude|chatgpt|copilot|gemini|codex|\bai\b)'; then
  reject "\"Generated with/by ...\" footer naming an AI tool"
fi

# Robot emoji (U+1F916, UTF-8 bytes F0 9F A4 96), written as octal escapes.
robot=$(printf '\360\237\244\226')
if printf '%s\n' "$body" | grep -Fq "$robot"; then
  reject "robot emoji (AI attribution marker)"
fi

exit 0
